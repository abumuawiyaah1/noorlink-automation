# =============================================================================
# NoorLink Automation — Environment Variables
# Copy to .env for local use. On Railway: Project → Variables → paste these.
# Never commit real secrets (.env is gitignored).
# =============================================================================

# —— App ——
ENVIRONMENT=production
DEBUG=false
APP_NAME=NoorLink Automation
APP_VERSION=1.0.0

# Frontend URL (Stripe success/cancel redirects)
APP_URL=https://noorlink.co
# Logo used in transactional emails (absolute HTTPS URL)
EMAIL_LOGO_URL=https://noorlink.co/images/logo.png
STRIPE_SUCCESS_PATH=/success
STRIPE_CANCEL_PATH=/checkout

# Comma-separated CORS origins (frontend domains that call this API)
CORS_ORIGINS=https://noorlink.co,https://www.noorlink.co

# —— Supabase (Dashboard → Project Settings → API) ——
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key

# Optional: direct Postgres URI for local migration scripts only
# DATABASE_URL=postgresql://postgres.[project-ref]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres

# Required for /admin SQLAdmin dashboard (use Supabase → Settings → Database → Connection pooler URI)
DATABASE_URL=postgresql://postgres.[project-ref]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres
ADMIN_ENABLED=true
# Comma-separated IPs allowed to reach /admin (empty = allow all). Use with Cloudflare Access.
ADMIN_ALLOWED_IPS=
# Break-glass secret for scripts/recover_owner.py and creating ADMIN_ROLE=owner (≥16 chars)
OWNER_RECOVERY_SECRET=

# —— Stripe (Dashboard → Developers → API keys + Webhooks) ——
# Use pk_live_ / sk_live_ in production; pk_test_ / sk_test_ for staging
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Optional — pin a Payment method configuration (pmc_...) with Apple Pay / Google Pay / Link on
# STRIPE_PAYMENT_METHOD_CONFIGURATION=pmc_...

# Enable wallets in Dashboard (required for phones):
# Settings → Payment methods → turn ON Cards, Apple Pay, Google Pay, Link
# https://dashboard.stripe.com/settings/payment_methods
# For on-page Apple Pay: Settings → Payment methods → Apple Pay → add domain noorlink.co

# —— Simbase (Dashboard → Integrations → API Keys + Webhooks) ——
# Authorization: Bearer <SIMBASE_API_KEY>
SIMBASE_API_KEY=sb_live_your_simbase_key
SIMBASE_API_BASE_URL=https://api.simbase.com/v2
# Must match the request token configured for your Simbase webhook endpoint
SIMBASE_WEBHOOK_SECRET=test_webhook_secret_key

# —— Citrus Mobile (Developer Portal → API key) ——
# Authorization: Bearer rsk_...
CITRUS_API_KEY=rsk_your_citrus_reseller_key
CITRUS_API_BASE_URL=https://citrusmobile.com/api/v2/reseller
# Returned once when you POST /webhooks — HMAC for X-Citrus-Signature
CITRUS_WEBHOOK_SECRET=whsec_...
# Default provider when plan_fulfillment_map has no hit: mock | citrus | esimaccess | simbase
ESIM_PROVIDER=citrus

# —— eSIM Access (Partner portal → AccessCode) ——
# Used as RT-AccessCode header and HMAC-SHA256 signing key. Server-only.
ESIM_ACCESS_ACCESS_CODE=your_esim_access_code
ESIM_ACCESS_API_BASE_URL=https://api.esimaccess.com/api/v1/open
# Optional; leave blank if unused. Do NOT put this in ESIM_ACCESS_ENFORCE_SAUDI.
ESIM_ACCESS_WEBHOOK_SECRET=
# Must be true/false (or leave unset). Blank/invalid values default to true.
# Saudi/Umrah must fulfill via eSIM Access map (sa-5gb-30 / sa-10gb-30 / sa-20gb-30)
ESIM_ACCESS_ENFORCE_SAUDI=true

# —— Telna Connect Flex (https://flex-developer.telna.com) ——
# Authorization header: raw token only (no "Bearer" prefix)
TELNA_API_TOKEN=
TELNA_ORDERING_BASE_URL=https://ppo-api.telna.com/v1/ordering
TELNA_DIAGNOSTIC_BASE_URL=https://ppo-api.telna.com/v1/diagnostic
# Optional; required if your Flex tenant scopes products by account
TELNA_ACCOUNT_ID=

# —— Resend (email delivery) ——
# Domain must be verified in Resend. Prefer the live site domain.
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=NoorLink <noreply@noorlink.co>
SUPPORT_EMAIL=support@noorlink.co
# Auto-refund unanswered refund tickets after N hours (strict: ≤20% usage, amount cap)
SUPPORT_AUTO_REFUND_WAIT_HOURS=48
SUPPORT_AUTO_REFUND_MAX_CENTS=5000
# Affiliate payout requests: auto-approve after N hours unattended (strict amount cap; still send funds manually)
AFFILIATE_AUTO_PAYOUT_WAIT_HOURS=72
AFFILIATE_AUTO_PAYOUT_MAX_CENTS=50000
# Extra inboxes (comma-separated) for new-ticket staff alerts
SUPPORT_STAFF_NOTIFY_EMAILS=
# Bearer token for POST /api/v1/webhooks/resend/inbound (Resend email.received)
RESEND_INBOUND_WEBHOOK_SECRET=
# Resend delivery events (bounce, complaint, delivered) → /api/v1/webhooks/resend/events
RESEND_EVENTS_WEBHOOK_SECRET=

# —— Ops alerts (paid but no QR / fulfillment failure) ——
# Email receives immediate alert; Slack optional incoming webhook
OPS_ALERT_EMAIL=support@noorlink.co
SLACK_WEBHOOK_URL=

# Optional — public review links in post-delivery emails
# Trustpilot preferred. Example: https://www.trustpilot.com/evaluate/noorlink.co
TRUSTPILOT_REVIEW_URL=
GOOGLE_REVIEW_URL=
# Trustpilot Automatic Feedback Service — BCC only on QR delivery emails
# Example: noorlink.co+xxxxx@invite.trustpilot.com
TRUSTPILOT_INVITE_BCC=

# —— Cron (Insider auto-release + promo expiry) ——
# Bearer token for POST /api/cron/run (GitHub Actions or Railway cron)
CRON_SECRET=generate-a-random-secret-key-here

# —— App Security ——
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=generate-a-random-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
