# =============================================================================
# NoorLink Automation — Environment Variables
# Copy to .env for local use. On Railway: Project → Variables → paste these.
# Never commit real secrets (.env is gitignored).
# =============================================================================

# —— App ——
ENVIRONMENT=production
DEBUG=false
APP_NAME=NoorLink Automation
APP_VERSION=1.0.0

# Frontend URL (Stripe success/cancel redirects)
APP_URL=https://noorlink.co
# Logo used in transactional emails (absolute HTTPS URL)
EMAIL_LOGO_URL=https://noorlink.co/images/logo.png
STRIPE_SUCCESS_PATH=/success
STRIPE_CANCEL_PATH=/checkout

# Comma-separated CORS origins (frontend domains that call this API)
CORS_ORIGINS=https://noorlink.co,https://www.noorlink.co

# —— Supabase (Dashboard → Project Settings → API) ——
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key

# Optional: direct Postgres URI for local migration scripts only
# DATABASE_URL=postgresql://postgres.[project-ref]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres

# —— Stripe (Dashboard → Developers → API keys + Webhooks) ——
# Use pk_live_ / sk_live_ in production; pk_test_ / sk_test_ for staging
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# —— Simbase (Dashboard → Integrations → API Keys + Webhooks) ——
# Authorization: Bearer <SIMBASE_API_KEY>
SIMBASE_API_KEY=sb_live_your_simbase_key
SIMBASE_API_BASE_URL=https://api.simbase.com/v2
# Must match the request token configured for your Simbase webhook endpoint
SIMBASE_WEBHOOK_SECRET=test_webhook_secret_key

# —— Citrus Mobile (Developer Portal → API key) ——
# Authorization: Bearer rsk_...
CITRUS_API_KEY=rsk_your_citrus_reseller_key
CITRUS_API_BASE_URL=https://citrusmobile.com/api/v2/reseller
# Returned once when you POST /webhooks — HMAC for X-Citrus-Signature
CITRUS_WEBHOOK_SECRET=whsec_...
# Default provider when plan_fulfillment_map has no hit: mock | citrus | esimaccess | simbase
ESIM_PROVIDER=citrus

# —— eSIM Access (Partner portal → AccessCode) ——
# Used as RT-AccessCode header and HMAC-SHA256 signing key. Server-only.
ESIM_ACCESS_ACCESS_CODE=your_esim_access_code
ESIM_ACCESS_API_BASE_URL=https://api.esimaccess.com/api/v1/open
# Optional; leave blank if unused. Do NOT put this in ESIM_ACCESS_ENFORCE_SAUDI.
ESIM_ACCESS_WEBHOOK_SECRET=
# Must be true/false (or leave unset). Blank/invalid values default to true.
# Saudi/Umrah must fulfill via eSIM Access map (sa-5gb-30 / sa-10gb-30 / sa-20gb-30)
ESIM_ACCESS_ENFORCE_SAUDI=true

# —— Resend (email delivery) ——
# Domain must be verified in Resend. Prefer the live site domain.
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=NoorLink <noreply@noorlink.co>

# —— App Security ——
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=generate-a-random-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
